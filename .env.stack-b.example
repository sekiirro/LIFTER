# Copy to .env.stack-b after PO approval. Fill placeholders from this command:
# `node <supabase-safe.mjs> --workdir <LFTR-014>/supabase-stack-b --stack B exec -- npx supabase status -o env`
# Never reuse Stack A keys.
API_URL=http://127.0.0.1:25421
DB_URL=postgres://postgres:<STACK_B_DATABASE_PASSWORD>@127.0.0.1:25422/postgres
ANON_KEY=<STACK_B_ANON_KEY>
SERVICE_ROLE_KEY=<STACK_B_SERVICE_ROLE_KEY>
SUPABASE_URL=http://127.0.0.1:25421
SUPABASE_DB_URL=postgres://postgres:<STACK_B_DATABASE_PASSWORD>@127.0.0.1:25422/postgres
SUPABASE_ANON_KEY=<STACK_B_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<STACK_B_SERVICE_ROLE_KEY>
JWT_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
# For Stack B, obtain values with supabase status from the supabase-stack-b/ working directory; root-profile status is Stack A.
