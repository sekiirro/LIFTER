{
  "name": "lifter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:migration-timestamps": "node scripts/check-migration-timestamps.mjs",
    "check:migration-versions:remote": "node scripts/check-migration-timestamps.mjs --all-remote-refs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "build:edge": "opennextjs-cloudflare build",
    "build:cron": "wrangler deploy --dry-run --config workers/cron/wrangler.jsonc --outdir .wrangler/cron-dist",
    "size": "node scripts/size-report.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "backup": "node scripts/backup/backup.mjs",
    "backup:restore-test": "node scripts/backup/restore-test.mjs",
    "backup:keygen": "node scripts/backup/keygen.mjs",
    "free-tier:db": "node scripts/free-tier/db-usage.mjs",
    "free-tier:probe": "node scripts/free-tier/http-probe.mjs",
    "free-tier:tail": "node scripts/free-tier/parse-tail.mjs",
    "free-tier:project": "node scripts/free-tier/project.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "geist": "1.8.2",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "glisse": "file:vendor/glisse"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@iarna/toml": "^2.2.5",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "age-encryption": "0.3.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "happy-dom": "^20.14.6",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.153.0",
    "@types/jsdom": "30.0.0",
    "jsdom": "29.1.1"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "@opennextjs/aws": {
        "@node-minify/core": {
          "glob": "10.5.0"
        }
      }
    }
  }
}
