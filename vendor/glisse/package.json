{
  "name": "glisse",
  "version": "0.5.0",
  "description": "A faithful implementation of Apple's Liquid Glass for the web.",
  "keywords": [
    "react",
    "liquid glass",
    "glass",
    "ui",
    "components",
    "tab bar",
    "segmented control",
    "switch",
    "slider",
    "menu"
  ],
  "license": "MIT",
  "author": "Kelvin Zhang <me@kelvinzhang.ca>",
  "homepage": "https://glisse.kelvinzhang.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0kzh/glisse.git"
  },
  "bugs": "https://github.com/0kzh/glisse/issues",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
